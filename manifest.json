{
  "manifest_version": 3,
  "name": "Bitrix24 Task Card Beautifier",
  "version": "0.1.0",
  "version_name": "0.1 pre",
  "description": "Улучшает внешний вид карточки задачи в Битрикс24",
  "permissions": ["storage"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/task-card.js"],
      "css": ["assets/task-card.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bitrix24 Task Card Beautifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
